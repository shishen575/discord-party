{
  "name": "discord-party",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client \"node --watch server/index.js\" \"vite\"",
    "dev:tunnel": "TUNNEL=1 npm run dev",
    "build": "vite build",
    "start": "node server/index.js",
    "setup": "npm install --include=dev && npm run build"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
